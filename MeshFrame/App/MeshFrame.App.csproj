<Project Sdk="Microsoft.NET.Sdk">
  <!-- MeshFrame.exe cho MỘT phiên bản Tekla: dotnet build -p:TeklaBin=<thư mục Tekla.Structures*.dll> -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MeshFrame</AssemblyName>
    <RootNamespace>MeshFrame.App</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <TeklaBin Condition="'$(TeklaBin)' == ''">C:\TeklaStructures\2025.0\bin</TeklaBin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\*.cs" />
    <Compile Include="..\UI\*.cs" />
    <Compile Include="..\Tekla\*.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Tekla.Structures"><HintPath>$(TeklaBin)\Tekla.Structures.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Tekla.Structures.Model"><HintPath>$(TeklaBin)\Tekla.Structures.Model.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
