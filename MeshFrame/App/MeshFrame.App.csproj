<Project Sdk="Microsoft.NET.Sdk">
  <!-- MeshFrame.exe: MỘT bản cho 21.1 / 2020 / 2025 (API Tekla nạp lúc chạy bằng reflection, không tham chiếu cứng) -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MeshFrame</AssemblyName>
    <RootNamespace>MeshFrame.App</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\*.cs" />
    <Compile Include="..\UI\*.cs" />
    <Compile Include="..\Tekla\*.cs" />
    <None Include="..\Fonts\*" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
